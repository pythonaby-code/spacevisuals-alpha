# Не коммить заполненный .env. Запуск: node --env-file=.env server.mjs
PORT=4187
# Локальное хранилище и аккаунты Windows определяются автоматически.
# SITE_DATA=/absolute/path/to/private/site-data
# SITE_LAUNCHER_ACCOUNTS=/absolute/path/to/private/accounts.json
# Ключи существующего издателя — только вне публичного каталога и Git.
# SITE_ISSUER_PRIVATE=/absolute/path/to/private/issuer-private.pem
# SITE_ISSUER_PUBLIC=/absolute/path/to/private/issuer-public.der
# SITE_PUBLIC_URL=https://your-domain.example
PAYMENT_MODE=disabled
